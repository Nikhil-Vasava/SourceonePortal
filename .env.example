# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# On Vercel, set these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Vercel Postgres, Neon and Supabase all work.
# Hosted providers require SSL, which the app enables automatically.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Signs the login cookie. Use a long random string — at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Asked for again before the Settings page will run a reset, even though you
# are already signed in as an admin. At least 4 characters. Without it the
# page stays locked and no reset can run.
SETTINGS_PIN=""

# ---------------------------------------------------------------------------
# Optional — packing slip reading. Bookings and purchase orders are parsed
# locally and need no keys at all. Without these, packing slip values can
# still be typed in by hand.
# ---------------------------------------------------------------------------

# Primary reader — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_FALLBACK_MODELS="gemini-2.0-flash-lite,gemini-2.5-flash,gemini-1.5-flash"

# ---- Outbound email (Purchase → Email a PO) -------------------------------
# Set these in Vercel's Environment Variables, never in the repo.
# SMTP_PASS must be an APP PASSWORD, not the mailbox's normal password —
# both Google and Microsoft stopped accepting account passwords over SMTP.
#
# Not sure which provider you're on? Look at where you read this mailbox:
# mail.google.com = Google Workspace, outlook.office.com = Microsoft 365.
#
# --- Google Workspace / Gmail ---
#   Requires 2-Step Verification on the account. On Workspace the admin must
#   also have "Allow users to generate app passwords" switched on, or the
#   option never appears. Generate at myaccount.google.com/apppasswords —
#   it's 16 characters; the spaces Google shows are for reading, drop them.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
#
# --- Microsoft 365 ---
#   SMTP AUTH is off by default on most tenants and has to be enabled per
#   mailbox by an admin. Microsoft is retiring password-based SMTP entirely:
#   disabled by default for existing tenants from the end of December 2026.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# The mailbox the portal signs in as, and the app password generated FROM THAT
# mailbox's own Google security settings.
SMTP_USER=
SMTP_PASS=

# Who the supplier sees it from. May differ from SMTP_USER — but only if it is
# a verified "Send mail as" alias on that account. If it isn't, Google does not
# error: it silently replaces From with SMTP_USER and the supplier sees the
# wrong sender. Check the first PO that goes out.
SMTP_FROM=SourceOne Ventures <details@sourceoneventures.nz>

# Optional. Defaults to SMTP_FROM, which is nearly always right — set this only
# if supplier replies should go somewhere other than the From address.
SMTP_REPLY_TO=
