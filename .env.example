# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# On Vercel, set these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Vercel Postgres, Neon and Supabase all work.
# Hosted providers require SSL, which the app enables automatically.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Signs the login cookie. Use a long random string — at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Asked for again before the Settings page will run a reset, even though you
# are already signed in as an admin. At least 4 characters. Without it the
# page stays locked and no reset can run.
SETTINGS_PIN=""

# ---------------------------------------------------------------------------
# Optional — packing slip reading. Bookings and purchase orders are parsed
# locally and need no keys at all. Without these, packing slip values can
# still be typed in by hand.
# ---------------------------------------------------------------------------

# Primary reader — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_FALLBACK_MODELS="gemini-2.0-flash-lite,gemini-2.5-flash,gemini-1.5-flash"

# ---- Outbound email --------------------------------------------------------
# Set these in Vercel's Environment Variables, never in the repo.
# SMTP_PASS must be an APP PASSWORD, not the mailbox's normal password —
# both Google and Microsoft stopped accepting account passwords over SMTP.
#
# Not sure which provider you're on? Look at where you read this mailbox:
# mail.google.com = Google Workspace, outlook.office.com = Microsoft 365.
#
# Google Workspace needs 2-Step Verification on the account, and the admin must
# have "Allow users to generate app passwords" switched on, or the option never
# appears. Generate at myaccount.google.com/apppasswords — 16 characters, and
# the spaces Google shows are for reading only.

# ---- shared defaults -------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ---- Purchase orders → suppliers -------------------------------------------
# Sent from the purchasing address suppliers already recognise.
SMTP_PO_USER=details@sourceoneventures.nz
SMTP_PO_PASS=
SMTP_PO_FROM=SourceOne Ventures <details@sourceoneventures.nz>

# ---- Operations notices (empty-pickup cron) --------------------------------
# Sent from whoever owns arranging the containers.
SMTP_OPS_USER=nikhil@sourceoneventures.nz
SMTP_OPS_PASS=
SMTP_OPS_FROM=SourceOne Ventures <nikhil@sourceoneventures.nz>

# Each _PASS is an app password generated while signed in AS that mailbox —
# an app password belongs to the account that created it.
#
# Alternative: if one of these is a verified "Send mail as" alias of the other,
# you can set a single SMTP_USER / SMTP_PASS plus the two _FROM lines above and
# skip the second password. Riskier — if the alias isn't verified, Google
# silently rewrites the From and the recipient sees the wrong sender.

# Optional per-identity override. Defaults to that identity's own FROM.
# SMTP_PO_REPLY_TO=
# SMTP_OPS_REPLY_TO=

# ---- Empty-pickup notice (daily cron) -------------------------------------
# Who gets told when a shipment's 14-day empty-collection window opens.
# Comma-separated. Falls back to SMTP_USER if unset.
# NOTE: this is only a RECIPIENT — it needs no password and no SMTP of its own.
# The message is sent from the SMTP_USER mailbox above.
OPS_NOTIFY_EMAIL=operations@sourceoneventures.nz

# Protects /api/cron/pickup-notice. Vercel sends it automatically as a Bearer
# token on scheduled runs. Without it the endpoint is publicly runnable, which
# means anyone can make it send mail — set it before going live.
CRON_SECRET=
